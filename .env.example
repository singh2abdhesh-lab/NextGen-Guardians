# ==============================================================================
# ENTERPRISE AI GUARDIAN - DEVOPS ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- Networking & Port Allocations ---
FRONTEND_PORT=3000
GATEWAY_PORT=8080
SCANNER_PORT=8081
RISK_PORT=8082
AUDIT_PORT=8083
QUALITY_PORT=8084
POSTGRES_PORT=5432
KAFKA_PORT=9092
ZOOKEEPER_PORT=2181

# --- PostgreSQL Database Credentials ---
POSTGRES_DB=ai_guardian_audit
POSTGRES_USER=guardian
POSTGRES_PASSWORD=guardian_secret_pass

# --- Apache Kafka Distributed Event Streaming ---
KAFKA_ENABLED=true
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_AUDIT=ai.audit.events
KAFKA_TOPIC_DLQ=ai.audit.events.DLT

# --- Enterprise Security & Cryptography ---
AI_SECURITY_JWT_SECRET=ai-guardian-enterprise-security-jwt-secret-key-super-secure-32bytes
AI_SECURITY_JWT_VALIDITY_SECONDS=3600
AI_SECURITY_AES_SECRET_KEY=enterprise-master-encryption-key-for-audit-logs

# --- LLM Upstream Gateway Integration ---
# When AI_UPSTREAM_MOCK=true, the gateway generates governed deterministic responses locally without external API costs.
# Set AI_UPSTREAM_MOCK=false and supply AI_UPSTREAM_OPENAI_KEY for live frontier LLM upstream completions.
AI_UPSTREAM_MOCK=true
AI_UPSTREAM_OPENAI_KEY=
AI_UPSTREAM_BASE_URL=https://api.openai.com
AI_UPSTREAM_DEFAULT_MODEL=gpt-4o
AI_UPSTREAM_TIMEOUT_MS=5000
AI_UPSTREAM_MAX_RETRIES=3

# --- Circuit Breaker Thresholds ---
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_TIMEOUT_MS=1500
AI_CIRCUIT_RESET_MS=10000

# --- Spring Active Profile ---
SPRING_PROFILES_ACTIVE=prod
